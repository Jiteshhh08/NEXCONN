# ---------------------------------------------------------------------------
# Vaani Room — application environment
# Copy this file to `.env` and fill in real values locally.
# Never commit `.env` or real credentials.
# ---------------------------------------------------------------------------

NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Client IP rate limiting. Use "none" unless a trusted proxy overwrites the
# configured header on every request.
TRUSTED_PROXY_HEADER="none"
TRUSTED_PROXY_HOPS="1"

# Nexconn integration. Keep these blank with the local chat provider.
NEXCONN_APP_KEY=""
NEXCONN_APP_SECRET=""
NEXCONN_API_BASE_URL=""
NEXCONN_WEBHOOK_SECRET=""
NEXCONN_CHAT_PROVIDER="local"

# Translation provider configuration.
TRANSLATION_PROVIDER="passthrough"
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""
MYMEMORY_EMAIL=""
