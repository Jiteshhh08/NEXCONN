# ---------------------------------------------------------------------------
# Vaani Room — environment variables
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` or any real credential.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV="development"

# Public base URL used to build room join links and QR destinations.
APP_BASE_URL="http://localhost:3000"

# Relational database. SQLite is used for local development;
# switch to a Postgres URL for production (see TEAM_LEAD.md).
DATABASE_URL="file:./dev.db"

# Long random value used to sign session and local transport tokens.
# Required at runtime in production. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Client IP resolution for rate limiting
# Set TRUSTED_PROXY_HEADER only when a proxy you control overwrites that header
# on every request (for example "x-forwarded-for" behind a load balancer).
# Leave "none" when the app is directly exposed: client-supplied forwarding
# headers are ignored and those requests share one conservative bucket.
# TRUSTED_PROXY_HOPS is the number of proxies between the client and the app.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_HEADER="none"
TRUSTED_PROXY_HOPS="1"

# ---------------------------------------------------------------------------
# Nexconn integration
# Fill these from the Nexconn Console for the account's region.
# NEXCONN_APP_SECRET is SERVER-ONLY. Never expose it to the browser, a
# NEXT_PUBLIC_* variable, a log, or Git.
# Leave the Nexconn values blank while NEXCONN_CHAT_PROVIDER="local".
# See docs/nexconn-integration-contract.md for the verified contracts.
# ---------------------------------------------------------------------------
NEXCONN_APP_KEY=""
NEXCONN_APP_SECRET=""
# Regional host, for example https://api.sg-light-api.com (Singapore),
# https://api.us-light-api.com (North America), or
# https://api.sau-light-api.com (Saudi Arabia). Confirm the account's region.
NEXCONN_API_BASE_URL=""

# Not part of the Nexconn contract: webhooks are signed with NEXCONN_APP_SECRET
# (there is no separate webhook secret). Kept for deployments that may add one.
NEXCONN_WEBHOOK_SECRET=""

# "local" uses the built-in development transport (no Nexconn account).
# "nexconn" switches the server adapter to Nexconn Chat Open Channels.
NEXCONN_CHAT_PROVIDER="local"

# ---------------------------------------------------------------------------
# Translation
# "passthrough" keeps the original text and reports translation as
# unavailable until a provider is connected (safe default for local dev).
# "nexconn" uses Nexconn's async translation module.
# "libretranslate" uses a LibreTranslate-compatible endpoint.
# ---------------------------------------------------------------------------
TRANSLATION_PROVIDER="passthrough"
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""
